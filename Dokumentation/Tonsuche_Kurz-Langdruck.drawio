                <mxCell id="note" value="Key Rules:&#10;• Kurzdruck aus 0: 0→1&#10;• Kurzdruck aus 1: 1→2&#10;• Ab dann toggelt Kurzdruck zwischen 1↔2&#10;• Langdruck NUR aus Modus 1: 1→0" style="shape=note;html=1;noLabel=0;align=left;fontSize=10;fillColor=#fffacd;strokeColor=#666" parent="1" vertex="1">
