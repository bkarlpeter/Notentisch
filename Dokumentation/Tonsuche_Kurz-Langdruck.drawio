                <mxCell id="a01" value="Kurz&#10;0→1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeWidth=2;fontSize=10" parent="1" source="state0" target="state1" edge="1">
